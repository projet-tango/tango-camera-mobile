<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                android:background="#111111"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/startStop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/start" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/section_pairing"
                android:textColor="#9DB8FF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/scan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_qr" />

            <EditText
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:hint="@string/code_hint"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="12"
                android:textColor="#EEEEEE"
                android:textColorHint="#777777" />

            <EditText
                android:id="@+id/server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints=""
                android:hint="@string/server_hint"
                android:inputType="textUri"
                android:textColor="#EEEEEE"
                android:textColorHint="#777777"
                android:textSize="14sp" />

            <Button
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/section_auto"
                android:textColor="#9DB8FF"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/bootStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/boot_start"
                android:textColor="#EEEEEE" />

            <Button
                android:id="@+id/overlayPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/overlay_permission"
                android:visibility="gone" />

            <Button
                android:id="@+id/batteryOptim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/battery_optim"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/launcherMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launcher_mode"
                android:textColor="#EEEEEE" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/tips"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>
</ScrollView>
